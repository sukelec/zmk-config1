/ {
    chosen {
        zmk,kscan = &kscan0;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;

        input-gpios
            = <&xiao_d 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Buton 1 (D0)
            , <&xiao_d 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Buton 2 (D1)
            , <&xiao_d 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Buton 3 (D2)
            , <&xiao_d 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Buton 4 (D3)
            , <&xiao_d 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Buton 5 (D4)
            , <&xiao_d 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Buton 6 (D5)
            , <&xiao_d 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Buton 7 (D6)
            , <&xiao_d 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Buton 8 (D7)
            ;
        };
};
