#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &default_layout;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;

        input-gpios
            = <&gpio0 6  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // 1. Buton (006)
            , <&gpio0 8  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // 2. Buton (008)
            , <&gpio0 17 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // 3. Buton (017)
            , <&gpio0 20 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // 4. Buton (020)
            , <&gpio0 22 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // 5. Buton (022)
            , <&gpio0 24 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // 6. Buton (024)
            , <&gpio1 0  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // 7. Buton (100)
            , <&gpio0 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // 8. Buton (011)
            ;
    };

    direct_transform: direct_transform {
        compatible = "zmk,matrix-transform";
        columns = <8>;
        rows = <1>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7)
        >;
    };

    layouts {
        compatible = "zmk,physical-layouts";
        default_layout: default_layout {
            compatible = "zmk,physical-layout";
            display-name = "Default Layout";
            transform = <&direct_transform>;
            kscan = <&kscan0>;
            
            /* Parametreler sırasıyla: Genişlik, Yükseklik, X_Konumu, Y_Konumu, Döndürme, RX, RY */
            keys = <
                <&key_physical_attrs 100 100   0   0 0 0 0> // 1. Tuş
                <&key_physical_attrs 100 100 100   0 0 0 0> // 2. Tuş
                <&key_physical_attrs 100 100 200   0 0 0 0> // 3. Tuş
                <&key_physical_attrs 100 100 300   0 0 0 0> // 4. Tuş
                <&key_physical_attrs 100 100 400   0 0 0 0> // 5. Tuş
                <&key_physical_attrs 100 100 500   0 0 0 0> // 6. Tuş
                <&key_physical_attrs 100 100 600   0 0 0 0> // 7. Tuş
                <&key_physical_attrs 100 100 700   0 0 0 0> // 8. Tuş
            >;
        };
    };
};
