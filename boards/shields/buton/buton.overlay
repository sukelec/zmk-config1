/ {
    chosen {
        zmk,kscan = &kscan0;
        /* ZMK Studio'nun bu yerleşimi kullanmasını zorunlu kılıyoruz */
        zmk,physical-layout = &default_layout;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;

        input-gpios
            = <&gpio0 6  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // 1. Buton (006)
            , <&gpio0 8  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // 2. Buton (008)
            , <&gpio0 17 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // 3. Buton (017)
            , <&gpio0 20 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // 4. Buton (020)
            , <&gpio0 22 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // 5. Buton (022)
            , <&gpio0 24 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // 6. Buton (024)
            , <&gpio1 0  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // 7. Buton (100)
            , <&gpio0 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // 8. Buton (011)
            ;
    };

    /* Doğrudan pin bağlantılarında matris dönüşümünü 1:1 yapmak için boş bir transform tanımı */
    direct_transform: direct_transform {
        compatible = "zmk,matrix-transform";
        columns = <8>;
        rows = <1>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7)
        >;
    };

    /* ZMK Studio'nun hata vermesini önleyen ve tuşları algılamasını sağlayan yeni blok */
    layouts {
        compatible = "zmk,physical-layouts";
        default_layout: default_layout {
            compatible = "zmk,physical-layout";
            display-name = "Default Layout";
            transform = <&direct_transform>;
            keys = <
                /* ZMK Studio arayüzündeki sanal x ve y koordinatları (X_koordinatı Y_koordinatı) */
                <&key_physical_attrs 0 0> // 1. Tuş
                <&key_physical_attrs 1 0> // 2. Tuş
                <&key_physical_attrs 2 0> // 3. Tuş
                <&key_physical_attrs 3 0> // 4. Tuş
                <&key_physical_attrs 4 0> // 5. Tuş
                <&key_physical_attrs 5 0> // 6. Tuş
                <&key_physical_attrs 6 0> // 7. Tuş
                <&key_physical_attrs 7 0> // 8. Tuş
            >;
        };
    };
};
