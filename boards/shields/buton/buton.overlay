/ {
    chosen {
        zmk,kscan = &kscan0;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;

        input-gpios
            = <&promicro 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&promicro 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&promicro 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&promicro 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&promicro 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&promicro 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&promicro 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&promicro 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            ;
    };
};
