#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";
        
        // 1. ve 2. butona aynı anda basıldığında Studio kilidini açar
        combo_studio_unlock {
            timeout-ms = <50>;
            key-positions = <0 1>; // 0: Birinci tuş, 1: İkinci tuş
            bindings = <&studio_unlock>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8
            >;
        };
    };
};